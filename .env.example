# Copy this file to .env for local development. Never commit .env.
# Generate BETTER_AUTH_SECRET with a cryptographically secure random generator.

# PostgreSQL (Docker exposes it at localhost:5433 to avoid common local conflicts.)
POSTGRES_USER=astrology_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=astrology_blog
DATABASE_URL=postgresql://astrology_app:replace-with-a-local-password@localhost:5433/astrology_blog

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Local MinIO (Docker exposes the S3 API at localhost:9002.)
MINIO_ROOT_USER=astrology_local_access
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=astrology-media
S3_ACCESS_KEY=astrology_local_access
S3_SECRET_KEY=replace-with-a-local-minio-password
S3_FORCE_PATH_STYLE=true

# A new developer-owned Google OAuth client can be enabled later, after local
# email/password auth has been verified. Leave these unset for now.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

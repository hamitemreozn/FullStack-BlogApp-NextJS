{
  "name": "astrology-blog-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:migrate:content": "tsx --env-file=.env scripts/migrate-content.ts",
    "db:seed:demo": "tsx --env-file=.env scripts/seed-demo-posts.ts",
    "storage:setup": "tsx --env-file=.env scripts/setup-storage.ts",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-presigned-post": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.4.9",
    "kysely": "^0.28.0",
    "next": "^16.0.0",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
